# 複製此檔為 .env.local 並填入實際值（.env* 不可進版控）
# 不填 Supabase 的值時，網站以「展示模式」執行（資料存在伺服器記憶體）。

# 強制展示模式：DATA_MODE=demo
DATA_MODE=

# Supabase（npx supabase start 會印出本機的值）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 僅限伺服器端

# 綠界 ECPay（測試環境，資料見綠界開發者文件）
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=your-hash-key                      # 僅限伺服器端
ECPAY_HASH_IV=your-hash-iv                        # 僅限伺服器端
ECPAY_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# LINE Login（後續版本）
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret      # 僅限伺服器端

# Vercel Cron 呼叫 /api/cron/expire-orders 時帶的密鑰
CRON_SECRET=change-me                             # 僅限伺服器端

# 網站（綠界回呼與桌卡 QR 網址會用到）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
