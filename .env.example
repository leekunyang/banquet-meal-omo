# 複製此檔為 .env.local 並填入實際值（.env* 不可進版控）

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 僅限伺服器端

# 綠界 ECPay（測試環境）
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=your-hash-key                      # 僅限伺服器端
ECPAY_HASH_IV=your-hash-iv                        # 僅限伺服器端
ECPAY_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# LINE Login
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret      # 僅限伺服器端

# 網站
NEXT_PUBLIC_SITE_URL=http://localhost:3000
